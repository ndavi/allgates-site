---
import Logo from './Logo.astro';
import { navigation, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <a class="site-footer__brand" href="/" aria-label="Allgates — Accueil"><Logo /></a>
      <p class="site-footer__descriptor">{site.descriptor}</p>
    </div>
    <nav aria-label="Navigation de pied de page">
      <ul>{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <span>© {new Date().getFullYear()} Allgates</span>
    <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-line); padding: 3.5rem 0 1.5rem; background: var(--color-surface); }
  .site-footer__grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 3rem; align-items: start; }
  .site-footer__brand { text-decoration: none; }
  .site-footer__descriptor { max-width: 24rem; margin: 0.9rem 0 0; color: var(--color-muted); font-size: 0.92rem; }
  .site-footer ul { display: flex; gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .site-footer nav a { color: var(--color-ink); font-size: 0.9rem; font-weight: 600; text-decoration: none; }
  .site-footer nav a:hover { color: var(--color-accent); }
  .site-footer__bottom { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; border-top: 1px solid var(--color-line); padding-top: 1.25rem; color: var(--color-muted); font-size: 0.76rem; }
  .site-footer__bottom a { text-underline-offset: 0.2em; }
  @media (max-width: 680px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .site-footer ul { display: grid; gap: 0.8rem; }
    .site-footer__bottom { flex-direction: column; }
  }
</style>

