---
const flow = [
	{
		label: 'Question de recherche',
		value: 'Quels échanges mentionnent la clause de résiliation ?',
	},
	{
		label: 'Éléments repérés',
		value: 'Deux messages et une pièce jointe comportent les termes recherchés.',
	},
	{
		label: 'Source consultable',
		value: 'Archive fournie · message du 14 mars · pièce associée',
	},
];
---

<figure class="document-flow" aria-labelledby="flow-title">
	<figcaption>
		<p class="flow-kicker">Exemple fictif et pédagogique</p>
		<h3 id="flow-title">Un résultat se lit avec son origine</h3>
	</figcaption>
	<ol>
		{flow.map((item, index) => (
			<li>
				<span class="flow-index" aria-hidden="true">{index + 1}</span>
				<div>
					<p class="flow-label">{item.label}</p>
					<p class="flow-value">{item.value}</p>
				</div>
			</li>
		))}
	</ol>
</figure>

<style>
	.document-flow {
		margin: 0;
		padding: clamp(1.5rem, 3vw, 2.8rem);
		background: var(--color-ink);
		color: white;
		border-radius: 1.25rem;
	}

	figcaption {
		max-width: 43rem;
	}

	.flow-kicker,
	.flow-label {
		margin: 0;
		color: #b9cef9;
		font-size: 0.875rem;
		font-weight: 750;
		letter-spacing: 0.04em;
	}

	h3 {
		max-width: 18ch;
		margin: 0.45rem 0 0.75rem;
		color: white;
		overflow-wrap: anywhere;
		font-size: clamp(1.55rem, 3vw, 2.35rem);
		line-height: 1.07;
		letter-spacing: -0.035em;
	}

	ol {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.8rem;
		min-width: 0;
		padding: 1rem 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.23);
	}

	.flow-index {
		display: grid;
		width: 1.45rem;
		height: 1.45rem;
		place-items: center;
		border-radius: 999px;
		background: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 800;
	}

	.flow-value {
		margin: 0.4rem 0 0;
		font-size: 0.96rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	@media (max-width: 720px) {
		ol {
			grid-template-columns: 1fr;
		}
	}
</style>
