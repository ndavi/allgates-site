---
import { contactEmail } from '../data/site';

interface Props {
  endpoint?: string;
}

const { endpoint = '' } = Astro.props;
const directSubmissionAvailable = endpoint !== '';
const emailHref = `mailto:${contactEmail}`;
---

<div class="contact-panel">
  <form
    class="contact-form"
    data-contact-form
    data-endpoint={endpoint}
    data-contact-email={contactEmail}
    action={directSubmissionAvailable ? endpoint : emailHref}
    method="POST"
  >
    <fieldset class="form-fields" data-fields>
      <div class="form-grid">
      <div class="field">
        <label for="contact-email">
          Email professionnel <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="field">
        <label for="contact-organization">
          Structure <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-organization"
          name="structure"
          type="text"
          autocomplete="organization"
          required
        />
      </div>

      <div class="field form-grid__wide">
        <label for="contact-name">Nom du contact <span>(facultatif)</span></label>
        <input
          id="contact-name"
          name="nom"
          type="text"
          autocomplete="name"
        />
      </div>

      <div class="field form-grid__wide">
        <label for="contact-need">
          Votre besoin <span aria-hidden="true">*</span>
        </label>
        <textarea
          id="contact-need"
          name="besoin"
          rows="7"
          required
          aria-describedby="contact-need-hint"
        ></textarea>
        <p class="field-hint" id="contact-need-hint">
          Décrivez le contexte et le résultat recherché, sans joindre ni copier de document confidentiel.
        </p>
      </div>
      </div>

      <div class="bot-trap" aria-hidden="true">
        <label for="contact-website">Site web</label>
        <input
          id="contact-website"
          name="_gotcha"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    </fieldset>

    <p
      class="form-status"
      id="contact-status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {directSubmissionAvailable
        ? 'Les champs marqués d’un astérisque sont obligatoires.'
        : 'Après validation, votre messagerie s’ouvrira avec le message prérempli. Vous devrez l’envoyer depuis celle-ci.'}
    </p>

    <div class="form-actions">
      <button class="button" type="submit" data-submit>
        {directSubmissionAvailable ? 'Envoyer ma demande' : 'Préparer mon email'}
      </button>
      <a class="text-link" href={emailHref}>Écrire directement à {contactEmail}</a>
    </div>
  </form>
</div>

<script>
  import { submitContact } from '../lib/contact';

  const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]');

  for (const form of forms) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.busy === 'true' || !form.reportValidity()) return;

      const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
      const fields = form.querySelector<HTMLFieldSetElement>('[data-fields]');
      const status = form.querySelector<HTMLElement>('#contact-status');
      if (!submitButton || !fields || !status) return;

      const setSubmitting = (submitting: boolean) => {
        form.dataset.busy = String(submitting);
        fields.disabled = submitting;
        submitButton.disabled = submitting;
        if (submitting) {
          submitButton.setAttribute('aria-busy', 'true');
        } else {
          submitButton.removeAttribute('aria-busy');
        }
      };

      const data = new FormData(form);
      const submission = {
        email: String(data.get('email') ?? ''),
        organization: String(data.get('structure') ?? ''),
        name: String(data.get('nom') ?? ''),
        need: String(data.get('besoin') ?? ''),
        website: String(data.get('_gotcha') ?? ''),
      };

      setSubmitting(true);
      status.dataset.kind = 'pending';
      status.setAttribute('role', 'status');

      const endpoint = form.dataset.endpoint ?? '';
      if (endpoint === '') {
        if (submission.website === '') {
          const contactEmail = form.dataset.contactEmail ?? '';
          const subject = `Demande de contact — ${submission.organization}`;
          const body = [
            'Bonjour,',
            '',
            `Je vous contacte au nom de ${submission.organization}.`,
            submission.name ? `Nom : ${submission.name}` : '',
            '',
            'Mon besoin :',
            submission.need,
            '',
            `Vous pouvez me répondre à ${submission.email}.`,
          ].filter((line, index, lines) => line !== '' || lines[index - 1] !== '').join('\n');

          status.textContent = 'Votre messagerie va s’ouvrir. Vérifiez le message, puis envoyez-le depuis celle-ci.';
          window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        } else {
          status.dataset.kind = 'error';
          status.setAttribute('role', 'alert');
          status.textContent = 'Le message n’a pas été préparé. Veuillez réessayer.';
        }

        setSubmitting(false);
        return;
      }

      status.textContent = 'Envoi de votre demande…';
      const result = await submitContact({ endpoint, submission });

      if (result.status === 'accepted') {
        form.reset();
        status.dataset.kind = 'success';
        status.textContent = 'Votre demande a bien été reçue. Nous reviendrons vers vous pour organiser un premier échange.';
      } else {
        status.dataset.kind = 'error';
        status.setAttribute('role', 'alert');
        status.textContent = result.status === 'unavailable'
          ? 'L’envoi direct est momentanément indisponible. Vous pouvez nous écrire avec le lien ci-dessous.'
          : 'Votre demande n’a pas pu être confirmée. Votre saisie est conservée : réessayez ou écrivez-nous directement.';
      }

      setSubmitting(false);
    });
  }
</script>

<style>
  .contact-panel {
    min-width: 0;
    padding: clamp(1rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: var(--color-surface);
    box-shadow: 0 1.25rem 3rem rgb(20 41 68 / 8%);
  }

  .contact-form {
    display: grid;
    min-width: 0;
    gap: 1.5rem;
  }

  .form-fields {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .form-grid {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .form-grid__wide {
    grid-column: 1 / -1;
  }

  .field {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 0.45rem;
  }

  label {
    color: var(--color-ink);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  label span:not([aria-hidden]) {
    color: var(--color-muted);
    font-size: 0.9em;
    font-weight: 500;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid #aebbd0;
    border-radius: 0.65rem;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
    line-height: 1.5;
    padding: 0.8rem 0.9rem;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  textarea {
    min-height: 10rem;
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: #7f91ad;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(36 91 235 / 18%);
    outline: none;
  }

  .field-hint,
  .form-status {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .form-status {
    border-left: 3px solid var(--color-line);
    padding: 0.25rem 0 0.25rem 0.8rem;
  }

  .form-status[data-kind='pending'] {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .form-status[data-kind='success'] {
    border-color: #16865b;
    color: #0d6543;
  }

  .form-status[data-kind='error'] {
    border-color: #ba3f4d;
    color: #8d2632;
  }

  .form-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    min-width: 0;
  }

  .form-actions .text-link {
    display: inline;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .bot-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 42rem) {
    .form-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .form-grid__wide {
      grid-column: auto;
    }

    .form-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .form-actions .button {
      width: 100%;
    }
  }
</style>
