---
interface Props {
	variant?: 'default' | 'legal-page';
}

const { variant = 'default' } = Astro.props;
const isLegalPage = variant === 'legal-page';

const sources = isLegalPage
	? [
			{ icon: 'mail', title: 'Messageries', text: 'PST et autres exports, avec les messages et leurs pièces jointes.' },
			{ icon: 'folder', title: 'Documents', text: 'PDF, fichiers bureautiques, images et dossiers transmis.' },
			{ icon: 'document', title: 'Espaces documentaires', text: 'SharePoint, OneDrive ou NAS, avec leur arborescence.' },
		]
	: [
			{ icon: 'mail', title: 'Messageries et PST', text: 'Boîtes, envoyés, supprimés' },
			{ icon: 'folder', title: 'Espaces fichiers', text: 'SharePoint, OneDrive, NAS' },
			{ icon: 'document', title: 'Scans et images', text: 'PDF, factures, photos' },
		];

const results = isLegalPage
	? [
			{ title: 'Retrouver un échange ou une clause', text: 'Recherche dans l’ensemble des messages, versions et documents.' },
			{ title: 'Relier un message à ses pièces jointes', text: 'Le contenu reste associé à sa source et à son contexte.' },
			{ title: 'Reconstituer une chronologie', text: 'Les dates, auteurs et événements utiles sont rapprochés.' },
		]
	: [
			{ title: 'Preuve d’exfiltration', text: 'Quel fichier est parti, quand et vers qui.' },
			{ title: 'Recherche à 360°', text: 'Retrouvez l’information dans tout le dossier.' },
			{ title: 'Dossier prêt pour l’audience', text: 'Sources, bordereau de pièces et force probante.' },
		];
---

<figure class:list={['flow', { 'flow--legal-page': isLegalPage }]} aria-label={isLegalPage ? 'Des archives du cabinet aux réponses utiles au dossier, grâce au système d’investigation numérique Allgates' : 'Des données brutes aux preuves judiciaires, grâce au système d’investigation numérique Allgates'}>
	<article class="card card--sources">
		<header><span>1</span><h3>{isLegalPage ? 'Vos archives à interroger' : 'Vos données brutes'}</h3></header>
		<ul>
			{sources.map((source) => (
				<li>
					{source.icon === 'mail' && <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="7" width="26" height="18"/><path d="m4 9 12 9 12-9"/></svg>}
					{source.icon === 'folder' && <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 8h10l3 4h13v14H3z"/></svg>}
					{source.icon === 'document' && <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 3h13l5 5v21H7zM20 3v6h5M11 15h10M11 20h10"/></svg>}
					<div><strong>{source.title}</strong><p>{source.text}</p></div>
				</li>
			))}
		</ul>
	</article>

	<div class="flow__connector" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M4 16h23M19 8l8 8-8 8"/></svg></div>

	<article class="card card--engine">
		<header><span>2</span><h3>Système d’investigation numérique{!isLegalPage && ' souverain'}</h3></header>
		<div class="card__seal">
			<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 27 7v8c0 7-4.6 11.5-11 14-6.4-2.5-11-7-11-14V7zM11 16l3 3 7-8"/></svg>
			<strong>{isLegalPage ? 'Traitement local et sécurisé' : '100 % local et sécurisé'}</strong>
		</div>
		<ul>
			<li><strong>Empreinte SHA-256</strong><p>Identifie les fichiers, même renommés.</p></li>
			<li><strong>Métadonnées révélées</strong><p>Retrouve les auteurs et dates réels.</p></li>
			<li><strong>OCR automatique</strong><p>Rend les scans et images recherchables.</p></li>
		</ul>
		<p class="card__promise">{isLegalPage ? 'Secret professionnel préservé.' : 'Zéro cloud. Secret professionnel préservé.'}</p>
	</article>

	<div class="flow__connector" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M4 16h23M19 8l8 8-8 8"/></svg></div>

	<article class="card card--results">
		<header><span>3</span><h3>{isLegalPage ? 'Les réponses recherchées' : 'Vos preuves judiciaires'}</h3></header>
		<ul>
			{results.map((result) => <li><strong>{result.title}</strong><p>{result.text}</p></li>)}
		</ul>
	</article>
</figure>

<style>
	.flow { display: grid; grid-template-columns: minmax(0, 1fr) 3.5rem minmax(0, 1.12fr) 3.5rem minmax(0, 1fr); gap: 0.75rem; align-items: stretch; margin: clamp(2rem, 4vw, 3.25rem) 0 0; }
	.card { display: flex; min-height: 25rem; flex-direction: column; border: 1px solid #a9b9cf; background: var(--color-surface); padding: clamp(1.1rem, 2vw, 1.5rem); }
	.card header { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; align-items: center; padding-bottom: 1.15rem; border-bottom: 1px solid var(--color-line); }
	.card header > span { display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid currentColor; color: var(--color-accent); font-size: 0.8rem; font-weight: 780; }
	.card h3 { margin: 0; font-size: clamp(1.05rem, 1.55vw, 1.3rem); letter-spacing: -0.035em; }
	.card ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
	.card li { min-width: 0; border-bottom: 1px solid var(--color-line); padding: 1rem 0; }
	.card li:last-child { border-bottom: 0; }
	.card li strong { display: block; font-size: 0.9rem; line-height: 1.35; }
	.card li p { margin: 0.2rem 0 0; color: var(--color-muted); font-size: 0.82rem; line-height: 1.45; }
	.card--sources li { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr); gap: 0.8rem; align-items: center; }
	.card--sources li > svg { width: 2rem; fill: none; stroke: var(--color-accent); stroke-width: 1.5; }
	.card--engine { border-color: #86a7f8; background: #dce7ff; box-shadow: 0.55rem 0.55rem 0 #b8cafa; }
	.card--engine header { border-bottom-color: #a9bef0; }
	.card--engine li { border-bottom-color: #b7c9ef; }
	.card__seal { display: flex; gap: 0.65rem; align-items: center; margin-top: 1rem; color: var(--color-accent); }
	.card__seal svg { width: 1.9rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; }
	.card__seal strong { font-size: 0.86rem; line-height: 1.35; }
	.card__promise { margin: auto 0 0; border-left: 2px solid var(--color-accent); padding-left: 0.75rem; color: var(--color-ink); font-size: 0.82rem; font-weight: 750; line-height: 1.4; }
	.card--results { border-color: var(--color-ink); background: var(--color-ink); }
	.card--results header, .card--results li { border-bottom-color: #38506d; }
	.card--results h3, .card--results li strong { color: white; }
	.card--results header > span { color: #9ab6ff; }
	.card--results li p { color: #c1cede; }
	.flow__connector { display: grid; min-width: 0; place-items: center; }
	.flow__connector svg { width: 2.7rem; fill: none; stroke: #7890ae; stroke-linecap: square; stroke-linejoin: miter; stroke-width: 1.5; }

	@media (max-width: 1050px) {
		.flow { width: min(100%, 42rem); grid-template-columns: 1fr; gap: 0; margin-inline: auto; }
		.card { min-height: 0; }
		.flow__connector { height: 3.25rem; }
		.flow__connector svg { width: 2.5rem; transform: rotate(90deg); }
		.card--engine { box-shadow: 0.4rem 0.4rem 0 #b8cafa; }
	}

	@media (max-width: 400px) {
		.card { padding: 1rem; }
	}
</style>
