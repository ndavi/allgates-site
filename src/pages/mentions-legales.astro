---
import SiteLayout from '../layouts/SiteLayout.astro';
import { legalCompany, site } from '../data/site';
---

<SiteLayout
  title={`Mentions légales | ${site.name}`}
  description="Les informations légales d’Allgates Sàrl, société suisse établie à Trélex."
>
  <section class="legal-page">
    <div class="container legal-page__content">
      <p class="eyebrow">Informations légales</p>
      <h1>Mentions légales</h1>
      <p class="legal-page__intro">Les coordonnées de l’entreprise éditrice de ce site.</p>

      <dl class="legal-details">
        <div>
          <dt>Raison sociale</dt>
          <dd>{legalCompany.name}</dd>
        </div>
        <div>
          <dt>Siège et adresse</dt>
          <dd>{legalCompany.address.map((line) => <>{line}<br /></>)}</dd>
        </div>
        <div>
          <dt>IDE</dt>
          <dd>{legalCompany.uid}</dd>
        </div>
        <div>
          <dt>Numéro au registre du commerce</dt>
          <dd>{legalCompany.commercialRegisterNumber}</dd>
        </div>
        <div>
          <dt>Registre du commerce</dt>
          <dd>{legalCompany.commercialRegister}</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd><a class="text-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></dd>
        </div>
      </dl>
    </div>
  </section>
</SiteLayout>

<style>
  .legal-page { padding: clamp(4rem, 8vw, 7rem) 0 var(--section-space); }
  .legal-page__content { max-width: 52rem; }
  .legal-page h1 { margin-top: 0.9rem; }
  .legal-page__intro { max-width: 38rem; margin-top: 1.5rem; color: var(--color-muted); font-size: 1.12rem; }
  .legal-details { margin: 3rem 0 0; border-top: 1px solid var(--color-line); }
  .legal-details > div { display: grid; grid-template-columns: minmax(13rem, 0.75fr) 1fr; gap: 2rem; border-bottom: 1px solid var(--color-line); padding: 1.3rem 0; }
  .legal-details dt { color: var(--color-muted); font-size: 0.9rem; font-weight: 650; }
  .legal-details dd { margin: 0; font-weight: 560; }
  @media (max-width: 560px) {
    .legal-details > div { grid-template-columns: 1fr; gap: 0.45rem; }
  }
</style>
