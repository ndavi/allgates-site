---
import ContactCta from '../components/ContactCta.astro';
import InvestigationFlow from '../components/InvestigationFlow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { interventionFramework, legalOffer, offerSteps } from '../data/legal-offer';

const title = 'Recherche dans les archives des cabinets d’avocats | Allgates';
const description = 'Allgates aide les cabinets d’avocats à retrouver rapidement les informations utiles dans leurs archives de messagerie et leurs documents.';
---

<SiteLayout title={title} description={description}>
	<section class="hero section">
		<div class="container">
			<div class="hero__intro">
				<div class="hero__copy">
					<p class="section-label">Recherche dans les archives juridiques</p>
					<h1>{legalOffer.headline}</h1>
				</div>
				<div class="hero__summary">
					<p class="hero__lead">Allgates prépare les archives du cabinet afin d’y mener des recherches précises et de restituer les éléments utiles avec leurs sources.</p>
					<a class="hero-cta" href="/contact/">
						<span>
							<strong>Parlons de votre dossier</strong>
							<small>Premier échange gratuit</small>
						</span>
						<svg viewBox="0 0 32 32" aria-hidden="true">
							<path d="M5.5 7.5h21v14h-12l-6 4v-4h-3z" />
							<path d="M10 12h12M10 17h8" />
						</svg>
					</a>
				</div>
			</div>
			<InvestigationFlow variant="legal-page" />
		</div>
	</section>

	<section class="section method" aria-labelledby="method-title">
		<div class="container">
			<p class="section-label">Le déroulement</p>
			<h2 id="method-title">Une prestation construite autour de votre question.</h2>
			<div class="method-list">
				{offerSteps.map((step, index) => (
					<article>
						<p class="step-number">{String(index + 1).padStart(2, '0')}</p>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section safeguards" aria-labelledby="safeguards-title">
		<div class="container safeguards__grid">
			<div>
				<p class="section-label">Avant l’intervention</p>
				<h2 id="safeguards-title">Un périmètre clair avant de commencer.</h2>
			</div>
			<div>
				<p class="safeguards__intro">Le diagnostic permet de vérifier que les archives disponibles, la question posée et la restitution attendue forment un ensemble cohérent.</p>
				<ul>
					{interventionFramework.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<div class="container contact-wrap">
		<ContactCta />
	</div>
</SiteLayout>

<style>
	.hero {
		padding-top: var(--hero-top-space);
		padding-bottom: clamp(3rem, 6vw, 5rem);
		background: linear-gradient(120deg, #edf3ff 0%, var(--color-bg) 56%, #f8faff 100%);
	}

	.hero__intro {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.55fr);
		gap: clamp(2rem, 7vw, 7rem);
		align-items: end;
	}

	.safeguards__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
		gap: clamp(2rem, 7vw, 7rem);
		align-items: start;
	}

	.hero__copy {
		max-width: 49rem;
	}

	.hero__summary {
		padding-top: 1.5rem;
		border-top: 3px solid var(--color-accent);
	}

	.section-label {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.035em;
	}

	h1,
	h2,
	h3,
	p {
		text-wrap: pretty;
	}

	h1,
	h2,
	h3 {
		color: var(--color-ink);
	}

	h1 {
		max-width: 17ch;
		margin: 0;
		font-size: clamp(2.65rem, 5vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.065em;
	}

	h2 {
		max-width: 20ch;
		margin: 0;
		font-size: clamp(2rem, 3.75vw, 3.5rem);
		line-height: 1.08;
		letter-spacing: -0.052em;
	}

	h3 {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}

	.hero__lead {
		max-width: 32rem;
		margin: 0 0 2rem;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 1.7vw, 1.2rem);
		line-height: 1.62;
	}

	.hero-cta {
		display: inline-flex;
		width: min(100%, 24rem);
		min-height: 5rem;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border: 1px solid var(--color-ink);
		border-radius: 0.15rem;
		background: var(--color-ink);
		box-shadow: 0.45rem 0.45rem 0 var(--color-accent);
		color: white;
		padding: 0.9rem 1rem 0.9rem 1.25rem;
		text-decoration: none;
		transition: box-shadow 160ms ease, transform 160ms ease;
	}

	.hero-cta strong,
	.hero-cta small {
		display: block;
	}

	.hero-cta strong {
		font-size: 1.02rem;
		font-weight: 760;
		line-height: 1.25;
	}

	.hero-cta small {
		margin-top: 0.3rem;
		color: #b9c7d8;
		font-size: 0.78rem;
		font-weight: 620;
		line-height: 1.3;
	}

	.hero-cta svg {
		width: 2.5rem;
		flex: none;
		fill: none;
		stroke: #7fa5ff;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1.5;
	}

	.hero-cta:hover {
		box-shadow: 0.2rem 0.2rem 0 var(--color-accent);
		transform: translate(0.25rem, 0.25rem);
	}

	.method-list article {
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-line);
	}

	.method-list p:not(.step-number) {
		margin: 0.75rem 0 0;
		color: var(--color-muted);
		line-height: 1.58;
	}

	.method h2 {
		margin-top: 0.35rem;
	}

	.method-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 3.5vw, 4rem);
		margin-top: clamp(3rem, 6vw, 5rem);
	}

	.step-number {
		margin: 0 0 2rem;
		color: var(--color-accent);
		font-size: 0.82rem;
		font-weight: 800;
	}

	.safeguards__intro {
		max-width: 38rem;
		margin: 1.5rem 0 0;
		color: var(--color-muted);
		font-size: 1.06rem;
		line-height: 1.62;
	}

	.safeguards {
		background: var(--color-ink);
	}

	.safeguards h2,
	.safeguards .section-label {
		color: white;
	}

	.safeguards .section-label {
		color: #b9cef9;
	}

	.safeguards__intro,
	.safeguards li {
		color: #d4ddea;
	}

	.safeguards ul {
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.safeguards li {
		position: relative;
		padding: 1rem 0 1rem 1.4rem;
		border-top: 1px solid rgba(255, 255, 255, 0.2);
		line-height: 1.55;
	}

	.safeguards li::before {
		position: absolute;
		left: 0;
		top: 1.55rem;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: #82a7ff;
		content: '';
	}

	.contact-wrap {
		padding-top: var(--section-space);
	}

	@media (max-width: 820px) {
		.hero__intro,
		.safeguards__grid {
			grid-template-columns: 1fr;
		}

		.method-list {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.hero {
			padding-top: 3rem;
		}

		h1,
		h2,
		h3,
		.hero__lead,
			.method-list p,
			.safeguards li {
			overflow-wrap: anywhere;
		}

		.hero-cta {
			max-width: 100%;
			gap: 1rem;
		}
	}
</style>
