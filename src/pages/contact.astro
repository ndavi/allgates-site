---
import ContactForm from '../components/ContactForm.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const configuredEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim() ?? '';
const endpoint = /^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(configuredEndpoint)
  ? configuredEndpoint
  : '';
---

<SiteLayout
  title="Contact | Allgates"
  description="Décrivez à Allgates le fonctionnement actuel et le résultat recherché pour préparer un premier échange."
>
  <section class="section contact-intro">
    <div class="container contact-intro__grid">
      <div class="contact-intro__copy">
        <p class="eyebrow">Prendre contact</p>
        <h1>Parlons de votre besoin.</h1>
        <p class="lead">
          Décrivez en quelques lignes le fonctionnement actuel et ce que vous souhaitez améliorer. Nous vous répondrons pour préciser la suite.
        </p>
      </div>

      <aside class="contact-note" aria-labelledby="before-writing-title">
        <p class="contact-note__label">Premier échange</p>
        <h2 id="before-writing-title">Restez au niveau du besoin</h2>
        <p>
          N’envoyez ni pièce de dossier, ni archive, ni donnée confidentielle depuis ce formulaire. Nous conviendrons ensemble d’un canal adapté si des éléments doivent être examinés.
        </p>
      </aside>
    </div>
  </section>

  <section class="section contact-content" aria-labelledby="contact-form-title">
    <div class="container contact-content__grid">
      <div class="contact-form-column">
        <ContactForm endpoint={endpoint} />
      </div>

      <div class="contact-context">
        <p class="eyebrow">Pour commencer</p>
        <h2 id="contact-form-title">Deux informations suffisent</h2>
        <p>
          Nous préciserons ensuite les contraintes, le périmètre et la prochaine étape avec vous.
        </p>

        <ol class="contact-steps">
          <li>
            <span>01</span>
            <div><strong>Votre contexte</strong><p>La structure concernée, le travail actuel et la difficulté rencontrée.</p></div>
          </li>
          <li>
            <span>02</span>
            <div><strong>Le résultat recherché</strong><p>Ce que vous aimeriez simplifier, automatiser ou rendre possible.</p></div>
          </li>
        </ol>
      </div>

    </div>
  </section>
</SiteLayout>

<style>
  .contact-intro {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .contact-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(17rem, 0.6fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .contact-intro__copy {
    max-width: 48rem;
  }

  h1 {
    max-width: 18ch;
    margin: 0.25rem 0 1.25rem;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .lead {
    max-width: 42rem;
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .eyebrow,
  .contact-note__label {
    margin: 0 0 0.85rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .contact-note {
    padding: 1.5rem 0 0.25rem 1.5rem;
    border-left: 2px solid var(--color-accent);
  }

  .contact-note h2 {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
  }

  .contact-note p:last-child {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .contact-content {
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
    background: linear-gradient(180deg, rgb(216 225 237 / 28%), transparent 22rem);
  }

  .contact-content__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 0.6fr) minmax(0, 1.4fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .contact-context {
    grid-column: 1;
    grid-row: 1;
    position: sticky;
    top: 7rem;
  }

  .contact-form-column {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .contact-context h2 {
    max-width: 12ch;
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .contact-context > p:not(.eyebrow) {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .contact-steps {
    display: grid;
    gap: 0;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .contact-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.9rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--color-line);
  }

  .contact-steps li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .contact-steps li > span {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .contact-steps strong {
    color: var(--color-ink);
  }

  .contact-steps p {
    margin: 0.3rem 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  @media (max-width: 52rem) {
    .contact-intro__grid,
    .contact-content__grid {
      grid-template-columns: 1fr;
    }

    .contact-intro__grid {
      align-items: start;
    }

    .contact-note {
      max-width: 42rem;
    }

    .contact-context {
      grid-column: auto;
      grid-row: 2;
      position: static;
    }

    .contact-form-column {
      grid-column: auto;
      grid-row: 1;
    }
  }
</style>
