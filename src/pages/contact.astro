---
import ContactForm from '../components/ContactForm.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const configuredEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim() ?? '';
const endpoint = configuredEndpoint === '/api/contact.php'
  ? configuredEndpoint
  : '';
---

<SiteLayout
  title="Contactez-nous | Allgates"
  description="Contactez Allgates pour discuter de votre besoin de recherche dans vos emails et documents."
>
  <section class="section contact-intro">
    <div class="container">
      <h1>Parlons de votre besoin.</h1>
      <p class="lead">Quelques lignes suffisent pour commencer. Nous vous recontacterons pour en discuter et convenir du travail à réaliser.</p>
    </div>
  </section>

  <section class="section contact-content" aria-labelledby="contact-form-title">
    <div class="container contact-content__grid">
      <div class="contact-context">
        <h2 id="contact-form-title">Écrivez-nous</h2>
        <p>Indiquez simplement ce que vous cherchez et les archives dont vous disposez, sans citer de client ni de détail confidentiel.</p>
      </div>
      <div class="contact-form-column">
        <ContactForm endpoint={endpoint} />
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .contact-intro { padding-top: var(--hero-top-space); }
  h1 { max-width: 20ch; margin-bottom: 1.25rem; font-size: clamp(2.5rem, 4.5vw, 4.25rem); }
  .lead { max-width: 42rem; color: var(--color-muted); font-size: clamp(1.1rem, 2vw, 1.25rem); }
  .contact-content { border-top: 1px solid var(--color-line); }
  .contact-content__grid { display: grid; grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .contact-context h2 { margin-bottom: 1rem; font-size: clamp(2rem, 3vw, 2.75rem); }
  .contact-context p { color: var(--color-muted); }
  @media (max-width: 52rem) {
    .contact-content__grid { grid-template-columns: 1fr; }
  }
</style>
