---
import ContactCta from '../components/ContactCta.astro';
import InvestigationFlow from '../components/InvestigationFlow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { benefits, credibility, method, site } from '../data/site';
---

<SiteLayout
  title="Allgates | Recherche documentaire pour entreprises"
  description={site.description}
>
  <section class="company-intro">
    <div class="container">
      <p>En tant qu’<strong>entreprise familiale</strong> ancrée en <strong>Suisse romande depuis 20 ans</strong>, nous accompagnons les dirigeants, les responsables opérationnels et PME qui souhaitent simplifier leur quotidien et améliorer leurs services.</p>
    </div>
  </section>

  <section id="recherche" class="hero">
    <div class="container">
      <div class="hero__content">
        <h1>Optimisez votre temps de travail grâce à un tri numérique sur mesure.</h1>
        <p class="hero__intro">Allgates déploie pour vous des solutions d’extraction massives pour cibler et valoriser vos données archivées en une fraction de seconde.</p>
      </div>
      <div class="hero__actions">
        <a class="hero-contact" href="/contact/">
          <span><strong>Contactez-nous</strong></span>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M5.5 7.5h21v14h-12l-6 4v-4h-3z" />
            <path d="M10 12h12M10 17h8" />
          </svg>
        </a>
      </div>
      <div class="expertise__list">
        {benefits.map((item) => (
          <article class="expertise__item"><h2>{item.title}</h2><p>{item.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section legal-offer">
    <div class="container">
      <div class="legal-offer__intro">
        <div>
          <p class="section-heading__label">Le fonctionnement</p>
          <h2>De vos archives aux informations recherchées</h2>
        </div>
        <div class="legal-offer__content">
          <p>Vous nous indiquez les informations qui vous intéressent. Nous les recherchons dans vos archives et vous livrons une application où elles sont regroupées, avec un accès aux documents d’origine.</p>
        </div>
      </div>

      <InvestigationFlow />
    </div>
  </section>

  <section class="section method-section">
    <div class="container">
      <div class="section-heading"><p class="section-heading__label">Comment commencer</p><h2>Commençons par les besoins de votre entreprise.</h2></div>
      <ol class="method">
        {method.map((item, index) => (
          <li><span class="method__index">{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section credibility">
    <div class="container credibility__grid">
      <div><p class="section-heading__label">Pourquoi Allgates</p><h2>Une entreprise familiale en Suisse romande</h2></div>
      <div>
        <p class="credibility__intro">Depuis vingt ans, Allgates est ancrée en Suisse romande. Aujourd’hui, notre entreprise familiale met son expérience du logiciel au service des entreprises qui souhaitent mieux exploiter leurs archives.</p>
        <ul>{credibility.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <div class="container contact-wrap"><ContactCta /></div>
</SiteLayout>

<style>
  .contact-wrap { padding-block: var(--section-space); }
  .company-intro { padding-block: clamp(1.25rem, 2vw, 1.75rem); }
  .company-intro p { max-width: 76ch; color: var(--color-muted); font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.75; }
  .company-intro strong { color: var(--color-ink); font-weight: 720; }
  .hero { padding-block: clamp(2.5rem, 4vw, 4rem); background: var(--color-surface); }
  .hero__content h1 { max-width: 34ch; font-size: clamp(2.5rem, 4.3vw, 4rem); text-wrap: balance; }
  .hero__intro { max-width: 72ch; margin-top: 1.5rem; color: var(--color-muted); font-size: clamp(1rem, 1.5vw, 1.12rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero-contact { display: inline-flex; width: fit-content; max-width: 100%; min-height: 3.25rem; align-items: center; justify-content: center; gap: 1rem; border: 1px solid var(--color-ink); border-radius: 0.15rem; background: var(--color-ink); color: white; padding: 0.8rem 1.25rem; text-decoration: none; transition: background-color 160ms ease, border-color 160ms ease; }
  .hero-contact strong { font-size: 1rem; font-weight: 720; line-height: 1.25; }
  .hero-contact svg { width: 1.5rem; flex: none; fill: none; stroke: #7fa5ff; stroke-linecap: square; stroke-linejoin: miter; stroke-width: 1.5; }
  .hero-contact:hover { background: var(--color-accent); border-color: var(--color-accent); }
  .hero-contact:hover svg { stroke: white; }
  .expertise__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(1.5rem, 3.5vw, 3rem); row-gap: 1rem; margin-top: clamp(2.5rem, 4vw, 3.5rem); }
  .expertise__item { display: grid; grid-template-rows: subgrid; grid-row: span 2; border-top: 1px solid var(--color-line); padding-top: 1.5rem; }
  .expertise__item h2 { max-width: 23ch; font-size: clamp(1.25rem, 2vw, 1.55rem); letter-spacing: -0.025em; line-height: 1.25; }
  .expertise__item p { margin-top: 0; color: var(--color-muted); }
  .legal-offer { background: #e8eef7; }
  .legal-offer__intro { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.7fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .legal-offer__intro h2 { max-width: 16ch; margin-top: 1rem; }
  .legal-offer__content > p { max-width: 39rem; color: var(--color-muted); font-size: 1.05rem; }
  .legal-offer__content .text-link { margin-top: 1.35rem; }
  .method-section { background: var(--color-ink); }
  .method-section :global(.section-heading__label) { color: #93a7c0; }
  .method-section h2, .method-section h3 { color: white; }
  .method { margin: 0; padding: 0; border-top: 1px solid #38506d; list-style: none; }
  .method li { display: grid; grid-template-columns: 4rem 1fr; gap: 1.5rem; border-bottom: 1px solid #38506d; padding: 1.5rem 0; }
  .method__index { color: #7fa5ff; font-size: 0.75rem; font-weight: 740; }
  .method li div { display: grid; grid-template-columns: minmax(13rem, 0.75fr) 1fr; gap: 2rem; }
  .method p { color: #b9c7d8; }
  .credibility { background: var(--color-surface); }
  .credibility__grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(3rem, 9vw, 8rem); }
  .credibility h2 { max-width: 13ch; margin-top: 1rem; }
  .credibility__intro { color: var(--color-muted); font-size: 1.12rem; }
  .credibility ul { margin: 2rem 0 0; padding: 0; list-style: none; }
  .credibility li { position: relative; border-top: 1px solid var(--color-line); padding: 1.15rem 0 1.15rem 1.5rem; font-weight: 620; overflow-wrap: anywhere; }
  .credibility li:last-child { border-bottom: 1px solid var(--color-line); }
  .credibility li::before { position: absolute; top: 1.65rem; left: 0; width: 0.45rem; height: 0.45rem; background: var(--color-accent); content: ''; }
  @media (max-width: 900px) {
    .credibility__grid { grid-template-columns: minmax(0, 1fr); }
    .legal-offer__intro { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 2.5rem; }
    .expertise__list { grid-template-columns: 1fr; gap: 1.75rem; }
    .expertise__item { grid-template-rows: auto auto; grid-row: auto; gap: 1rem; }
    .method li { grid-template-columns: 2.5rem 1fr; gap: 1rem; }
    .method li div { grid-template-columns: 1fr; gap: 0.7rem; }
  }
  @media (max-width: 400px) {
    .hero { padding-block: 2.5rem 4rem; }
    .method li { grid-template-columns: 1fr; }
  }
</style>
