---
import ContactCta from '../components/ContactCta.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { competencies, credibility, method } from '../data/site';
---

<SiteLayout
  title="Allgates | Logiciels sur mesure, automatisation et conseil IT"
  description="Allgates accompagne en Suisse romande les organisations qui veulent mieux exploiter leurs informations, automatiser leurs opérations ou faire évoluer leurs outils."
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="hero__kicker">Logiciels sur mesure, automatisation et conseil IT</p>
        <h1>Des outils adaptés à votre manière de travailler.</h1>
        <p class="hero__intro">Allgates accompagne en Suisse romande les dirigeants, responsables opérationnels et cabinets d’avocats qui veulent retrouver plus facilement leurs informations, traiter davantage de volume ou disposer d’outils mieux adaptés à leur activité.</p>
        <div class="hero__actions">
          <a class="hero-cta" href="/contact/">
            <span>
              <strong>Parlez de votre besoin</strong>
              <small>Premier échange gratuit</small>
            </span>
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M5.5 7.5h21v14h-12l-6 4v-4h-3z" />
              <path d="M10 12h12M10 17h8" />
            </svg>
          </a>
        </div>
      </div>

      <div class="flow" aria-label="D’un point de friction à un travail simplifié">
        <div class="flow__rail" aria-hidden="true"></div>
        <div class="flow__step flow__step--source">
          <span class="flow__number">01</span>
          <div><strong>Situation à améliorer</strong><span>Informations dispersées · tâches manuelles · outils inadaptés</span></div>
          <svg viewBox="0 0 70 44" aria-hidden="true"><path d="M4 8h19v10h20v18h23"/><circle cx="4" cy="8" r="3"/><circle cx="4" cy="30" r="3"/><circle cx="66" cy="36" r="3"/><path d="M4 30h17V18"/></svg>
        </div>
        <div class="flow__step flow__step--core">
          <span class="flow__number">02</span>
          <div><strong>Intervention ciblée</strong><span>Logiciel · automatisation · audit · conseil</span></div>
          <svg viewBox="0 0 70 44" aria-hidden="true"><rect x="16" y="4" width="38" height="36"/><path d="M7 22h9M54 22h9M35 4V0M35 44v-4"/></svg>
        </div>
        <div class="flow__step flow__step--use">
          <span class="flow__number">03</span>
          <div><strong>Résultat opérationnel</strong><span>Recherche facilitée · capacité accrue · décisions éclairées</span></div>
          <svg viewBox="0 0 70 44" aria-hidden="true"><path d="M4 22h17l8-12 12 24 8-12h17"/><circle cx="4" cy="22" r="3"/><circle cx="66" cy="22" r="3"/></svg>
        </div>
      </div>
    </div>
  </section>

  <section id="expertises" class="section expertise">
    <div class="container">
      <div class="section-heading"><p class="section-heading__label">Nos interventions</p><h2>Du besoin métier à la solution utile.</h2></div>
      <div class="expertise__list">
        {competencies.map((item) => (
          <article class="expertise__item"><h3>{item.title}</h3><p>{item.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section legal-offer">
    <div class="container">
      <div class="legal-offer__intro">
        <div>
          <p class="section-heading__label">Une offre pour les cabinets d’avocats</p>
          <h2>Transformez des archives dispersées en preuves exploitables.</h2>
        </div>
        <div class="legal-offer__content">
          <p>Allgates analyse les messageries, espaces de fichiers et documents scannés pour faire ressortir les faits, leurs auteurs et leurs sources.</p>
          <a class="text-link" href="/avocats/">Découvrir l’offre pour avocats</a>
        </div>
      </div>

      <figure class="forensic-flow" aria-label="Des données brutes aux preuves judiciaires, grâce au moteur forensique Allgates">
        <article class="forensic-card forensic-card--sources">
          <header><span>1</span><h3>Vos données brutes</h3></header>
          <ul>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="7" width="26" height="18"/><path d="m4 9 12 9 12-9"/></svg>
              <div><strong>Messageries et PST</strong><p>Boîtes, envoyés, supprimés</p></div>
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 8h10l3 4h13v14H3z"/></svg>
              <div><strong>Espaces fichiers</strong><p>SharePoint, OneDrive, NAS</p></div>
            </li>
            <li>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 3h13l5 5v21H7zM20 3v6h5M11 15h10M11 20h10"/></svg>
              <div><strong>Scans et images</strong><p>PDF, factures, photos</p></div>
            </li>
          </ul>
        </article>

        <div class="forensic-flow__connector" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M4 16h23M19 8l8 8-8 8"/></svg></div>

        <article class="forensic-card forensic-card--engine">
          <header><span>2</span><h3>Moteur forensique souverain</h3></header>
          <div class="forensic-card__seal">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 27 7v8c0 7-4.6 11.5-11 14-6.4-2.5-11-7-11-14V7zM11 16l3 3 7-8"/></svg>
            <strong>100 % local et sécurisé</strong>
          </div>
          <ul>
            <li><strong>Empreinte SHA-256</strong><p>Identifie les fichiers, même renommés.</p></li>
            <li><strong>Métadonnées révélées</strong><p>Retrouve les auteurs et dates réels.</p></li>
            <li><strong>OCR automatique</strong><p>Rend les scans et images recherchables.</p></li>
          </ul>
          <p class="forensic-card__promise">Zéro cloud. Secret professionnel préservé.</p>
        </article>

        <div class="forensic-flow__connector" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M4 16h23M19 8l8 8-8 8"/></svg></div>

        <article class="forensic-card forensic-card--results">
          <header><span>3</span><h3>Vos preuves judiciaires</h3></header>
          <ul>
            <li><strong>Preuve d’exfiltration</strong><p>Quel fichier est parti, quand et vers qui.</p></li>
            <li><strong>Recherche à 360°</strong><p>Retrouvez l’information dans tout le dossier.</p></li>
            <li><strong>Dossier prêt pour l’audience</strong><p>Sources, bordereau de pièces et force probante.</p></li>
          </ul>
        </article>
      </figure>
    </div>
  </section>

  <section class="section method-section">
    <div class="container">
      <div class="section-heading"><p class="section-heading__label">Notre méthode</p><h2>Un parcours clair avant tout engagement.</h2></div>
      <ol class="method">
        {method.map((item, index) => (
          <li><span class="method__index">{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section credibility">
    <div class="container credibility__grid">
      <div><p class="section-heading__label">Pourquoi Allgates</p><h2>Des expériences complémentaires au service de votre projet.</h2></div>
      <div>
        <p class="credibility__intro">Allgates associe une expertise approfondie du développement logiciel à une connaissance durable des environnements de service et de leurs exigences opérationnelles.</p>
        <ul>{credibility.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <div class="container contact-wrap"><ContactCta /></div>
</SiteLayout>

<style>
  .hero { overflow: hidden; padding: var(--hero-top-space) 0 clamp(2.5rem, 4vw, 4rem); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(2.5rem, 4vw, 5rem); align-items: center; }
  .hero__content h1 { max-width: 15ch; font-size: clamp(2.75rem, 5vw, 4.5rem); }
  .hero__kicker { margin-bottom: 1.5rem; color: var(--color-accent); font-size: 0.88rem; font-weight: 740; }
  .hero__intro { max-width: 43rem; margin-top: 2rem; color: var(--color-muted); font-size: clamp(1.06rem, 2vw, 1.25rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  :global(.hero-cta) { display: inline-flex; width: min(100%, 24rem); min-height: 5rem; align-items: center; justify-content: space-between; gap: 2rem; border: 1px solid var(--color-ink); border-radius: 0.15rem; background: var(--color-ink); box-shadow: 0.45rem 0.45rem 0 var(--color-accent); color: white; padding: 0.9rem 1rem 0.9rem 1.25rem; text-decoration: none; transition: box-shadow 160ms ease, transform 160ms ease; }
  :global(.hero-cta strong), :global(.hero-cta small) { display: block; }
  :global(.hero-cta strong) { font-size: 1.02rem; font-weight: 760; line-height: 1.25; }
  :global(.hero-cta small) { margin-top: 0.3rem; color: #b9c7d8; font-size: 0.78rem; font-weight: 620; line-height: 1.3; }
  :global(.hero-cta svg) { width: 2.5rem; flex: none; fill: none; stroke: #7fa5ff; stroke-linecap: square; stroke-linejoin: miter; stroke-width: 1.5; }
  :global(.hero-cta:hover) { box-shadow: 0.2rem 0.2rem 0 var(--color-accent); transform: translate(0.25rem, 0.25rem); }
  .flow { position: relative; display: grid; min-width: 0; gap: 0.75rem; padding-left: 1.5rem; }
  .flow__rail { position: absolute; top: 12%; bottom: 12%; left: 0; width: 1px; background: var(--color-accent); }
  .flow__rail::before, .flow__rail::after { position: absolute; left: -3px; width: 7px; height: 7px; background: var(--color-accent); content: ''; }
  .flow__rail::before { top: 0; } .flow__rail::after { bottom: 0; }
  .flow__step { display: grid; min-width: 0; grid-template-columns: auto minmax(0, 1fr) 4.3rem; gap: 1rem; align-items: center; border: 1px solid var(--color-line); background: var(--color-surface); padding: clamp(1rem, 2vw, 1.35rem); box-shadow: 0 12px 35px rgba(28, 53, 87, 0.055); }
  .flow__step--core { margin-left: 1rem; border-color: #9eb9fb; background: #e9efff; }
  .flow__number { color: var(--color-accent); font-size: 0.75rem; font-weight: 760; }
  .flow__step strong { display: block; font-size: 0.98rem; }
  .flow__step div span { display: block; margin-top: 0.15rem; color: var(--color-muted); font-size: 0.875rem; }
  .flow svg { width: 4.3rem; fill: none; stroke: var(--color-accent); stroke-width: 1.5; }
  .flow svg circle { fill: var(--color-accent); stroke: none; }
  .expertise { background: var(--color-surface); }
  .expertise__list { border-top: 1px solid var(--color-line); }
  .expertise__item { display: grid; grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1fr); gap: 2rem; align-items: start; border-bottom: 1px solid var(--color-line); padding: 1.5rem 0; }
  .expertise__item p { max-width: 43rem; color: var(--color-muted); }
  .legal-offer { background: #e8eef7; }
  .legal-offer__intro { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.7fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .legal-offer__intro h2 { max-width: 16ch; margin-top: 1rem; }
  .legal-offer__content > p { max-width: 39rem; color: var(--color-muted); font-size: 1.05rem; }
  .legal-offer__content .text-link { margin-top: 1.35rem; }
  .forensic-flow { display: grid; grid-template-columns: minmax(0, 1fr) 3.5rem minmax(0, 1.12fr) 3.5rem minmax(0, 1fr); gap: 0.75rem; align-items: stretch; margin: clamp(2rem, 4vw, 3.25rem) 0 0; }
  .forensic-card { display: flex; min-height: 25rem; flex-direction: column; border: 1px solid #a9b9cf; background: var(--color-surface); padding: clamp(1.1rem, 2vw, 1.5rem); }
  .forensic-card header { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; align-items: center; padding-bottom: 1.15rem; border-bottom: 1px solid var(--color-line); }
  .forensic-card header > span { display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid currentColor; color: var(--color-accent); font-size: 0.8rem; font-weight: 780; }
  .forensic-card h3 { font-size: clamp(1.05rem, 1.55vw, 1.3rem); letter-spacing: -0.035em; }
  .forensic-card ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .forensic-card li { min-width: 0; border-bottom: 1px solid var(--color-line); padding: 1rem 0; }
  .forensic-card li:last-child { border-bottom: 0; }
  .forensic-card li strong { display: block; font-size: 0.9rem; line-height: 1.35; }
  .forensic-card li p { margin-top: 0.2rem; color: var(--color-muted); font-size: 0.82rem; line-height: 1.45; }
  .forensic-card--sources li { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr); gap: 0.8rem; align-items: center; }
  .forensic-card--sources li > svg { width: 2rem; fill: none; stroke: var(--color-accent); stroke-width: 1.5; }
  .forensic-card--engine { border-color: #86a7f8; background: #dce7ff; box-shadow: 0.55rem 0.55rem 0 #b8cafa; }
  .forensic-card--engine header { border-bottom-color: #a9bef0; }
  .forensic-card--engine li { border-bottom-color: #b7c9ef; }
  .forensic-card__seal { display: flex; gap: 0.65rem; align-items: center; margin-top: 1rem; color: var(--color-accent); }
  .forensic-card__seal svg { width: 1.9rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .forensic-card__seal strong { font-size: 0.86rem; line-height: 1.35; }
  .forensic-card__promise { margin-top: auto; border-left: 2px solid var(--color-accent); padding-left: 0.75rem; color: var(--color-ink); font-size: 0.82rem; font-weight: 750; line-height: 1.4; }
  .forensic-card--results { border-color: var(--color-ink); background: var(--color-ink); }
  .forensic-card--results header, .forensic-card--results li { border-bottom-color: #38506d; }
  .forensic-card--results h3, .forensic-card--results li strong { color: white; }
  .forensic-card--results header > span { color: #9ab6ff; }
  .forensic-card--results li p { color: #c1cede; }
  .forensic-flow__connector { display: grid; min-width: 0; place-items: center; }
  .forensic-flow__connector svg { width: 2.7rem; fill: none; stroke: #7890ae; stroke-linecap: square; stroke-linejoin: miter; stroke-width: 1.5; }
  .method-section { background: var(--color-ink); }
  .method-section :global(.section-heading__label) { color: #93a7c0; }
  .method-section h2, .method-section h3 { color: white; }
  .method { margin: 0; padding: 0; border-top: 1px solid #38506d; list-style: none; }
  .method li { display: grid; grid-template-columns: 4rem 1fr; gap: 1.5rem; border-bottom: 1px solid #38506d; padding: 1.5rem 0; }
  .method__index { color: #7fa5ff; font-size: 0.75rem; font-weight: 740; }
  .method li div { display: grid; grid-template-columns: minmax(13rem, 0.75fr) 1fr; gap: 2rem; }
  .method p { color: #b9c7d8; }
  .credibility { background: var(--color-surface); }
  .credibility__grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(3rem, 9vw, 8rem); }
  .credibility h2 { max-width: 13ch; margin-top: 1rem; }
  .credibility__intro { color: var(--color-muted); font-size: 1.12rem; }
  .credibility ul { margin: 2rem 0 0; padding: 0; list-style: none; }
  .credibility li { position: relative; border-top: 1px solid var(--color-line); padding: 1.15rem 0 1.15rem 1.5rem; font-weight: 620; overflow-wrap: anywhere; }
  .credibility li:last-child { border-bottom: 1px solid var(--color-line); }
  .credibility li::before { position: absolute; top: 1.65rem; left: 0; width: 0.45rem; height: 0.45rem; background: var(--color-accent); content: ''; }
  @media (max-width: 900px) {
    .hero__grid, .credibility__grid { grid-template-columns: 1fr; }
    .hero__content h1 { max-width: 13ch; }
    .flow { max-width: 38rem; }
    .legal-offer__intro { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 1050px) {
    .forensic-flow { width: min(100%, 42rem); grid-template-columns: 1fr; gap: 0; margin-inline: auto; }
    .forensic-card { min-height: 0; }
    .forensic-flow__connector { height: 3.25rem; }
    .forensic-flow__connector svg { width: 2.5rem; transform: rotate(90deg); }
    .forensic-card--engine { box-shadow: 0.4rem 0.4rem 0 #b8cafa; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 2.5rem; }
    .flow { padding-left: 0.85rem; }
    .flow__step { grid-template-columns: auto 1fr; }
    .flow__step svg { display: none; }
    .flow__step--core { margin-left: 0.5rem; }
    .expertise__item { grid-template-columns: 1fr; gap: 1rem; }
    .method li { grid-template-columns: 2.5rem 1fr; gap: 1rem; }
    .method li div { grid-template-columns: 1fr; gap: 0.7rem; }
  }
  @media (max-width: 400px) {
    .hero { padding-block: 2.5rem 4rem; }
    .hero__actions { align-items: stretch; flex-direction: column; }
    :global(.hero-cta) { width: calc(100% - 0.45rem); gap: 1rem; }
    .flow { padding-left: 0.5rem; }
    .flow__step { grid-template-columns: 1fr; gap: 0.5rem; padding: 0.75rem; }
    .flow__step--core { margin-left: 0; }
    .flow__number { font-size: 0.75rem; }
    .forensic-card { padding: 1rem; }
    .method li { grid-template-columns: 1fr; }
  }
</style>
